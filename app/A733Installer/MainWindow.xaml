<Window x:Class="A733Installer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="760" SizeToContent="Height" WindowStartupLocation="CenterScreen" ResizeMode="CanMinimize"
        Background="#F4F6F9" FontFamily="Segoe UI" FontSize="13" Foreground="#1F2937"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Window.Resources>
    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="White"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="16,14"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
      <Setter Property="BorderBrush" Value="#E2E6EC"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style x:Key="Num" TargetType="Border">
      <Setter Property="Width" Value="26"/>
      <Setter Property="Height" Value="26"/>
      <Setter Property="CornerRadius" Value="13"/>
      <Setter Property="Background" Value="#FDE7D9"/>
      <Setter Property="Margin" Value="0,0,12,0"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style x:Key="Btn" TargetType="Button">
      <Setter Property="Padding" Value="14,6"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#CBD2DC"/>
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinWidth" Value="84"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Border.Background><SolidColorBrush x:Name="bg" Color="White"/></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="#EEF1F5" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="White" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Accent" TargetType="Button">
      <Setter Property="Padding" Value="26,10"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="7" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
              <Border.Background><SolidColorBrush x:Name="bg" Color="#EA580C"/></Border.Background>
              <Border.RenderTransform><ScaleTransform x:Name="sc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="#C2410C" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="#EA580C" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/>
                  <DoubleAnimation Storyboard.TargetName="sc" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Background" Value="#F3B28F"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="#1F2937"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="White" BorderBrush="#CBD2DC" BorderThickness="1" CornerRadius="6">
                      <Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0"
                            Data="M 0 0 L 5 5 L 10 0" Stroke="#6B7280" StrokeThickness="1.6"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#F59E0B"/></Trigger>
                      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Bd" Property="BorderBrush" Value="#EA580C"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter IsHitTestVisible="False" Margin="10,0,32,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
              <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                <Border Background="White" BorderBrush="#E2E6EC" BorderThickness="1" CornerRadius="8" Margin="0,4,10,10" Padding="4"
                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                  <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.16"/></Border.Effect>
                  <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Bd" CornerRadius="5" Padding="10,7" Background="Transparent">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FFF1E6"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Bd" Property="Background" Value="#FDE7D9"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="19" Height="19" CornerRadius="5" BorderThickness="1.5" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.Background><SolidColorBrush x:Name="boxBg" Color="White"/></Border.Background>
                <Border.BorderBrush><SolidColorBrush x:Name="boxBd" Color="#9CA3AF"/></Border.BorderBrush>
                <Border.RenderTransform><ScaleTransform x:Name="boxSc" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                <!-- dash units are multiples of StrokeThickness: the check is ~6.5 units long -->
                <Path x:Name="Mark" Data="M 3.5 8.5 L 7 12 L 13 5" Stroke="White" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      StrokeDashArray="7 7" StrokeDashOffset="7"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="boxBd" Storyboard.TargetProperty="Color" To="#EA580C" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="boxBd" Storyboard.TargetProperty="Color" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="boxBg" Storyboard.TargetProperty="Color" To="#EA580C" Duration="0:0:0.14"/>
                  <ColorAnimation Storyboard.TargetName="boxBd" Storyboard.TargetProperty="Color" To="#EA580C" Duration="0:0:0.14"/>
                  <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="StrokeDashOffset" To="0" BeginTime="0:0:0.06" Duration="0:0:0.22">
                    <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="boxSc" Storyboard.TargetProperty="ScaleX" From="0.85" To="1" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                  <DoubleAnimation Storyboard.TargetName="boxSc" Storyboard.TargetProperty="ScaleY" From="0.85" To="1" Duration="0:0:0.25">
                    <DoubleAnimation.EasingFunction><BackEase EasingMode="EaseOut" Amplitude="0.6"/></DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard>
                  <ColorAnimation Storyboard.TargetName="boxBg" Storyboard.TargetProperty="Color" Duration="0:0:0.15"/>
                  <ColorAnimation Storyboard.TargetName="boxBd" Storyboard.TargetProperty="Color" Duration="0:0:0.15"/>
                  <DoubleAnimation Storyboard.TargetName="Mark" Storyboard.TargetProperty="StrokeDashOffset" To="7" Duration="0:0:0.12"/>
                </Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="#C2410C"/>
      <Setter Property="TextDecorations" Value="{x:Null}"/>
      <Style.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter Property="TextDecorations" Value="Underline"/></Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Expander">
            <StackPanel>
              <ToggleButton Cursor="Hand" HorizontalAlignment="Left" Content="{TemplateBinding Header}"
                            IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="ToggleButton">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                      <Path x:Name="Chev" Data="M 0 0 L 4 4 L 0 8" Stroke="#6B7280" StrokeThickness="1.7" VerticalAlignment="Center"
                            Margin="2,0,9,0" RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform><RotateTransform x:Name="ChevRot" Angle="0"/></Path.RenderTransform>
                      </Path>
                      <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="#4B5563"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevRot" Storyboard.TargetProperty="Angle" To="90" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ChevRot" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chev" Property="Stroke" Value="#EA580C"/></Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <ContentPresenter x:Name="Body" Visibility="Collapsed"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsExpanded" Value="True"><Setter TargetName="Body" Property="Visibility" Value="Visible"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Lang" TargetType="Button">      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontSize" Value="11.5"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="9" Padding="10,2">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Danger" TargetType="Button">
      <Setter Property="Padding" Value="20,8"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <Border.Background><SolidColorBrush x:Name="bg" Color="#DC2626"/></Border.Background>
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="#B91C1C" Duration="0:0:0.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                <Trigger.ExitActions><BeginStoryboard><Storyboard><ColorAnimation Storyboard.TargetName="bg" Storyboard.TargetProperty="Color" To="#DC2626" Duration="0:0:0.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
  <StackPanel x:Name="Root" VerticalAlignment="Top">
    <Border Padding="26,18,22,18">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#EA580C" Offset="0"/>
          <GradientStop Color="#F59E0B" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <StackPanel x:Name="HeadText" Margin="0,2,0,0">
          <TextBlock x:Name="HeadTitle" FontSize="23" FontWeight="SemiBold" Foreground="White"/>
          <TextBlock x:Name="SubTitle" Foreground="#FFF1E6" Margin="0,3,0,0"/>
        </StackPanel>
        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Top" Orientation="Horizontal">
          <Border Background="#33FFFFFF" CornerRadius="10" Padding="10,3" Margin="0,0,10,0" VerticalAlignment="Center">
            <TextBlock x:Name="Badge" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
          </Border>
          <Border Background="#26000000" CornerRadius="11" Padding="2" VerticalAlignment="Center">
            <Grid>
              <!-- white thumb that slides under the selected language -->
              <Border x:Name="LangThumb" Width="38" Background="White" CornerRadius="9" HorizontalAlignment="Left">
                <Border.RenderTransform><TranslateTransform x:Name="LangThumbX" X="0"/></Border.RenderTransform>
              </Border>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="LangEn" Style="{StaticResource Lang}" Content="EN" Width="38"/>
                <Button x:Name="LangRu" Style="{StaticResource Lang}" Content="RU" Width="38"/>
              </StackPanel>
            </Grid>
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ===================== setup page ===================== -->
    <StackPanel x:Name="SetupPage" Margin="24,16,24,22">
      <Border Background="#FFF7ED" BorderBrush="#FDBA74" BorderThickness="1" CornerRadius="8" Padding="12,9" Margin="0,0,0,12">
        <TextBlock TextWrapping="Wrap" Foreground="#9A3412">
          <Run x:Name="WarnBold" FontWeight="SemiBold"/><Run x:Name="WarnRest"/>
        </TextBlock>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Border x:Name="Num1" Style="{StaticResource Num}"><TextBlock x:Name="Num1Text" Text="1" Foreground="#C2410C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel>
            <TextBlock x:Name="S1Title" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="S1Hint" Foreground="#6B7280" Margin="0,1,0,8"/>
            <DockPanel>
              <Button x:Name="RefreshBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0"/>
              <ComboBox x:Name="DiskBox" Height="32" VerticalContentAlignment="Center"/>
            </DockPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Border x:Name="Num2" Style="{StaticResource Num}"><TextBlock x:Name="Num2Text" Text="2" Foreground="#C2410C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel>
            <TextBlock x:Name="S2Title" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock Foreground="#6B7280" Margin="0,1,0,8" TextWrapping="Wrap">
              <Run x:Name="S2HintA"/><Hyperlink x:Name="MsLink" NavigateUri="https://www.microsoft.com/software-download/windows11arm64">microsoft.com</Hyperlink><Run x:Name="S2HintB"/>
            </TextBlock>
            <DockPanel>
              <Button x:Name="FolderBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0"/>
              <Button x:Name="IsoBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="8,0,0,0"/>
              <Border BorderBrush="#CBD2DC" BorderThickness="1" CornerRadius="4" Background="#F9FAFB" Height="30">
                <TextBlock x:Name="SourceText" Foreground="#9CA3AF" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
              </Border>
            </DockPanel>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border Style="{StaticResource Card}">
        <DockPanel>
          <Border x:Name="Num3" Style="{StaticResource Num}"><TextBlock x:Name="Num3Text" Text="3" Foreground="#C2410C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
          <StackPanel>
            <TextBlock x:Name="S3Title" FontWeight="SemiBold" FontSize="14"/>
            <TextBlock x:Name="S3Hint" Foreground="#6B7280" Margin="0,1,0,8"/>
            <ComboBox x:Name="EditionBox" Height="32" VerticalContentAlignment="Center"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border x:Name="StatusBox" Background="#FEF2F2" BorderBrush="#FECACA" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,12" Visibility="Collapsed">
        <DockPanel>
          <Border DockPanel.Dock="Left" Width="20" Height="20" CornerRadius="10" Background="#DC2626" Margin="0,0,10,0" VerticalAlignment="Top">
            <TextBlock Text="!" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock x:Name="Status" Foreground="#991B1B" TextWrapping="Wrap" VerticalAlignment="Center"/>
        </DockPanel>
      </Border>

      <Border Height="1" Background="#E2E6EC" Margin="0,2,0,14"/>
      <DockPanel Margin="0,0,0,0">
        <Button x:Name="StartBtn" DockPanel.Dock="Right" Style="{StaticResource Accent}" IsEnabled="False"/>
        <CheckBox x:Name="AgreeBox" VerticalAlignment="Center" VerticalContentAlignment="Center">
          <TextBlock x:Name="AgreeText" TextWrapping="Wrap"/>
        </CheckBox>
      </DockPanel>
    </StackPanel>

    <!-- ===================== progress page ===================== -->
    <StackPanel x:Name="ProgressPage" Margin="24,18,24,22" Visibility="Collapsed">
      <TextBlock x:Name="ProgTitle" FontSize="18" FontWeight="SemiBold"/>
      <TextBlock x:Name="ProgSub" Foreground="#6B7280" Margin="0,2,0,14" TextWrapping="Wrap"/>
      <Border Style="{StaticResource Card}">
        <StackPanel x:Name="StepPanel"/>
      </Border>
      <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100" Foreground="#EA580C" Background="#E5E7EB" BorderThickness="0" Margin="0,4,0,6"/>
      <TextBlock x:Name="ProgText" Foreground="#6B7280" Text=" "/>

      <Border x:Name="DonePanel" Background="#ECFDF5" BorderBrush="#6EE7B7" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="DoneHead" FontWeight="SemiBold" Foreground="#065F46" FontSize="14"/>
          <TextBlock x:Name="DoneText" TextWrapping="Wrap" Foreground="#065F46" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>
      <Border x:Name="FailPanel" Background="#FEF2F2" BorderBrush="#FCA5A5" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,12,0,0" Visibility="Collapsed">
        <StackPanel>
          <TextBlock x:Name="FailHead" FontWeight="SemiBold" Foreground="#991B1B" FontSize="14"/>
          <TextBlock x:Name="FailText" TextWrapping="Wrap" Foreground="#991B1B" Margin="0,4,0,0"/>
        </StackPanel>
      </Border>

      <Expander x:Name="LogExpander" Margin="0,12,0,0">
        <TextBox x:Name="LogBox" Height="150" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Margin="0,6,0,0"
                 Background="#111827" Foreground="#E5E7EB" BorderThickness="0" Padding="6"/>
      </Expander>
      <DockPanel Margin="0,14,0,0">
        <Button x:Name="CloseBtn" DockPanel.Dock="Right" Style="{StaticResource Btn}" IsEnabled="False"/>
        <Button x:Name="LogBtn" DockPanel.Dock="Left" Style="{StaticResource Btn}" HorizontalAlignment="Left"/>
      </DockPanel>
    </StackPanel>
  </StackPanel>

  <!-- ===================== in-window dialog (confirm / stop) ===================== -->
  <Grid x:Name="Overlay" Visibility="Collapsed" Background="#73111827">
    <Border x:Name="DialogCard" Background="White" CornerRadius="12" Width="470" Padding="22,20" VerticalAlignment="Center" HorizontalAlignment="Center"
            RenderTransformOrigin="0.5,0.5">
      <Border.Effect><DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.25"/></Border.Effect>
      <Border.RenderTransform><ScaleTransform x:Name="DialogScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
      <StackPanel>
        <DockPanel>
          <Border x:Name="DialogIcon" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="19" Background="#FEE2E2" Margin="0,0,14,0" VerticalAlignment="Top">
            <TextBlock Text="!" FontSize="20" FontWeight="Bold" Foreground="#DC2626" HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel>
            <TextBlock x:Name="DialogTitle" FontSize="17" FontWeight="SemiBold"/>
            <TextBlock x:Name="DialogText" TextWrapping="Wrap" Foreground="#4B5563" Margin="0,6,0,0" LineHeight="19"/>
            <Border x:Name="DialogDiskBox" Background="#F4F6F9" CornerRadius="6" Padding="10,7" Margin="0,10,0,0">
              <TextBlock x:Name="DialogDisk" FontWeight="SemiBold" TextWrapping="Wrap"/>
            </Border>
          </StackPanel>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
          <Button x:Name="DialogNo" Style="{StaticResource Btn}" Padding="18,8" Margin="0,0,10,0" IsCancel="True"/>
          <Button x:Name="DialogYes" Style="{StaticResource Danger}"/>
        </StackPanel>
      </StackPanel>
    </Border>
  </Grid>
  </Grid>
</Window>