  0x00, 0x00, 0x00, 0x00
}

0x00008000|0x007F8000
gArmTokenSpaceGuid.PcdFvBaseAddress|gArmTokenSpaceGuid.PcdFvSize
FV = FVMAIN_COMPACT

[FV.FVMAIN_COMPACT]
