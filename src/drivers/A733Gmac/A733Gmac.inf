[Version]
Signature="$Windows NT$"
Class=Net
ClassGuid={4d36e972-e325-11ce-bfc1-08002be10318}
Provider=%Provider%
DriverVer=11/15/2026,0.2.3.0
CatalogFile=A733Gmac.cat
PnpLockDown=1

[Manufacturer]
%Provider%=A733,NTarm64.10.0...26100

[A733.NTarm64.10.0...26100]
%DeviceDesc%=A733Gmac.ndi,ACPI\AWIN0040

[A733Gmac.ndi.NT]
FeatureScore=0xFE
Characteristics=0x04
BusType=15
*IfType=6
*MediaType=0
*PhysicalMediaType=14
*IfConnectorPresent=1
*ConnectionType=1
*DirectionType=0
*AccessType=2
*HardwareLoopback=0
CopyFiles=Driver.CopyFiles
AddReg=Ndi.Reg

[Ndi.Reg]
HKR,Ndi\Interfaces,UpperRange,0,"ndis5"
HKR,Ndi\Interfaces,LowerRange,0,"ethernet"
HKR,Ndi,Service,0,%ServiceName%

[A733Gmac.ndi.NT.Wdf]
KmdfService=%ServiceName%,Wdf

[Wdf]
KmdfLibraryVersion=$KMDFVERSION$

[A733Gmac.ndi.NT.Services]
AddService=%ServiceName%,2,Service.Install,Service.EventLog

[Service.Install]
DisplayName=%ServiceDisplayName%
ServiceType=1
StartType=3
ErrorControl=1
ServiceBinary=%13%\A733Gmac.sys
AddReg=Service.Reg

[Service.Reg]
HKR,,BootFlags,0x00010001,1

[Service.EventLog]
AddReg=EventLog.Reg

[EventLog.Reg]
HKR,,EventMessageFile,0x00020000,"%%SystemRoot%%\System32\netevent.dll"
HKR,,TypesSupported,0x00010001,7

[Driver.CopyFiles]
A733Gmac.sys

[DestinationDirs]
Driver.CopyFiles=13

[SourceDisksNames]
1=%DiskName%

[SourceDisksFiles]
A733Gmac.sys=1

[Strings]
