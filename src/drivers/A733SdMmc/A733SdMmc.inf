[Version]
Signature="$WINDOWS NT$"
Class=SDHost
ClassGuid={a0a588a4-c46f-4b37-b7ea-c82fe89870c6}
Provider=%Provider%
DriverVer=11/18/2026,2.6.0.0
CatalogFile=A733SdMmc.cat
PnpLockdown=1

[Manufacturer]
%Manufacturer%=Models,NTARM64.10.0...22000

[ControlFlags]
ExcludeFromSelect=*

[Models.NTARM64.10.0...22000]
%A733Sd.DeviceDesc%=A733Sd_Install,ACPI\AWIN0001

[A733Sd_Install.NT]
CopyFiles=DriverCopy

[A733Sd_Install.NT.Services]
AddService=A733SdMmc,0x00000002,A733Sd_Service

[A733Sd_Install.NT.HW]
AddReg=A733Sd_LocationReg

[A733Sd_Service]
DisplayName=%ServiceDesc%
ServiceType=1
StartType=0
ErrorControl=1
ServiceBinary=%13%\A733SdMmc.sys
LoadOrderGroup=System Bus Extender
AddReg=A733Sd_ServiceReg

[A733Sd_LocationReg]
HKR,,UINumberDescFormat,,%SDHostSlot%

[A733Sd_ServiceReg]
HKR,Parameters,SdCmdFlags,1,    05,01, 06,01, 08,11, 09,19, 0A,19, 0D,11, \
                                10,01, 11,01, 12,01, 17,01, 18,05, 19,05, \
                                1A,01, 1B,01, 1C,01, \
                                20,05, 21,05, 26,05, \
                                2A,01, \
                                34,02, 35,02, \
                                37,01, 38,01, \
                                22,01, 23,05, 24,01, 25,01
HKR,Parameters,SdAppCmdFlags,1, 06,01, 0D,01, 16,01, 17,01, 33,01, \
                                12,01, 19,01, 1A,01, 26,01, 2B,01, \
                                2C,01, 2D,01, 2E,01, 2F,01, 30,01, 31,01

[DestinationDirs]
DriverCopy=13

[DriverCopy]
A733SdMmc.sys

[SourceDisksNames]
1=%DiskName%,,,

[SourceDisksFiles]
A733SdMmc.sys=1

