  gOrangePi4ProTokenSpaceGuid.PcdUefiMemorySize|0x04000000|UINT32|0x00000007
  gOrangePi4ProTokenSpaceGuid.PcdEhci1Base|0x04200000|UINT64|0x00000008
  gOrangePi4ProTokenSpaceGuid.PcdSdMmc0Base|0x04020000|UINT64|0x00000009
  gOrangePi4ProTokenSpaceGuid.PcdAcpiCpuCount|8|UINT32|0x0000000A
  gOrangePi4ProTokenSpaceGuid.PcdPsciCpuOnSelfTest|TRUE|BOOLEAN|0x0000000B
  gOrangePi4ProTokenSpaceGuid.PcdExposeEhci1ToWindows|TRUE|BOOLEAN|0x0000000C
  gOrangePi4ProTokenSpaceGuid.PcdExposeSdMmc0ToWindows|FALSE|BOOLEAN|0x0000000D
  gOrangePi4ProTokenSpaceGuid.PcdExposeXhci2ToWindows|FALSE|BOOLEAN|0x0000000E
  # v60: CPU clock level set before Windows (A733CpuFreqDxe): 0 off, 1 <=800 mV, 2 <=950 mV, 3 bin max
  gOrangePi4ProTokenSpaceGuid.PcdA733CpuFreqLevel|2|UINT32|0x0000000F
  # v60: DWC3 bridge clocks CCU 0x1360 usb2-u3-utmi / 0x1364 usb2-u2-pipe.
  # 0 = exactly v59 (24 MHz OSC, gate on, GCTL as v59), 1 = vendor DT rates 60 / 120 MHz, gate on (default),
  # 2 = exactly the live Linux values (DT rates, gate off).
  gOrangePi4ProTokenSpaceGuid.PcdA733UsbBridgeClockMode|0|UINT32|0x00000010
  # v60: UART for the ACPI SPCR (Windows EMS/SAC console): 0 = debug UART0 (shared with KD), 7 = UART7 (R_UART0) on 40-pin header pins 8/10
  gOrangePi4ProTokenSpaceGuid.PcdA733SpcrUart|0|UINT32|0x00000011
  gOrangePi4ProTokenSpaceGuid.PcdA733SerialBBaudRate|115200|UINT32|0x00000012
